# Timezone & Localization (Defaults to IST - Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# Storage Backend Mode: "local" | "cloudinary" | "supabase"
# - "local": Reads from local PC folder (./inbox), native YouTube scheduling, PC can be turned off, Instagram disabled.
# - "cloudinary": 25 GB free storage without credit card, supports both YouTube & Instagram.
# - "supabase": Supabase storage bucket (1 GB free).
STORAGE_BACKEND=local
LOCAL_INBOX_DIR=./inbox
YOUTUBE_NATIVE_SCHEDULE=true

# Cloudinary (only needed if STORAGE_BACKEND=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Django
DJANGO_SECRET_KEY=                               # long random string (generate with python scripts/gen_secrets.py)
DJANGO_DEBUG=false
APP_PUBLIC_URL=https://your-app.onrender.com     # used for OAuth redirect, email links, CSRF
ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
RUN_SCHEDULER=1                                  # set 0 for tests and one-off commands
SESSION_COOKIE_AGE_HOURS=24

# Supabase Postgres (Django / psycopg 3).
# Use the SESSION POOLER string from Supabase > Project Settings > Database > Connection string.
# Host looks like aws-0-<region>.pooler.supabase.com, port 5432, user postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (same project; public bucket, free plan: 1 GB total, 50 MB per file)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                       # server only, never rendered into any page
SUPABASE_BUCKET=shorts                           # must be a PUBLIC bucket
STORAGE_INBOX_PREFIX=inbox/
MAX_FILE_MB=50

# Admin login (single admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=                             # bcrypt hash (generate with python scripts/gen_secrets.py)

# Encryption key for stored OAuth tokens (Fernet, 32 url-safe base64 bytes)
ENCRYPTION_KEY=

# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_PUBLIC_URL}/accounts/youtube/callback

# Meta / Instagram
META_APP_ID=1812942066591106
META_APP_SECRET=78d91004d27000ebb5651886484f5b0c
GRAPH_API_VERSION=v27.0                          # set to a currently supported version

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
